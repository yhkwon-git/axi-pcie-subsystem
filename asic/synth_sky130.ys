# Map the sv2v netlist onto Sky130 HD.
# ABC targets ss_n40C_1v40 so the gate delays it optimizes are the slow corner.
# -D 4500 is a 4.5 ns Q-to-D target, inside the clk_pcie output budget after
# clock-to-q. dfflibmap stays on tt and keeps the small flop cells.
# mux4/or4/nor4/or3/nor3 stay out: at ss_n40C_1v40 their fastest fall arc is
# already above 2 ns, so one of them plus clock-to-q misses an 8 ns period
# once setup and the 0.25 ns uncertainty are counted. clkbuf_* stays out of
# the data path for the same reason.
# asic/run_sky130.sh regenerates asic/build/subsystem.v and runs this script.

read_verilog asic/build/subsystem.v
hierarchy -check -top nand_sol_subsystem_top
synth -top nand_sol_subsystem_top
# -constr selects ABC's buffer/upsize/dnsize script. The FIFO read address
# is a single-cycle path (rd_data is mem[rd_bin] in the same cycle the
# bridge samples it), so the fanout is buffered instead of waived.
dfflibmap -liberty asic/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty asic/pdk/sky130_fd_sc_hd__ss_n40C_1v40.lib -constr asic/abc.constr -D 4500 -dont_use sky130_fd_sc_hd__mux4_1 -dont_use sky130_fd_sc_hd__mux4_2 -dont_use sky130_fd_sc_hd__mux4_4 -dont_use sky130_fd_sc_hd__or3_1 -dont_use sky130_fd_sc_hd__or3_2 -dont_use sky130_fd_sc_hd__or3_4 -dont_use sky130_fd_sc_hd__or4_1 -dont_use sky130_fd_sc_hd__or4_2 -dont_use sky130_fd_sc_hd__or4_4 -dont_use sky130_fd_sc_hd__nor3_1 -dont_use sky130_fd_sc_hd__nor3_2 -dont_use sky130_fd_sc_hd__nor3_4 -dont_use sky130_fd_sc_hd__nor4_1 -dont_use sky130_fd_sc_hd__nor4_2 -dont_use sky130_fd_sc_hd__nor4_4 -dont_use sky130_fd_sc_hd__nor3b_1 -dont_use sky130_fd_sc_hd__nor3b_2 -dont_use sky130_fd_sc_hd__nor3b_4 -dont_use sky130_fd_sc_hd__nor4b_1 -dont_use sky130_fd_sc_hd__nor4b_2 -dont_use sky130_fd_sc_hd__nor4b_4 -dont_use sky130_fd_sc_hd__nor4bb_1 -dont_use sky130_fd_sc_hd__nor4bb_2 -dont_use sky130_fd_sc_hd__nor4bb_4 -dont_use sky130_fd_sc_hd__or3b_1 -dont_use sky130_fd_sc_hd__or3b_2 -dont_use sky130_fd_sc_hd__or3b_4 -dont_use sky130_fd_sc_hd__or4b_1 -dont_use sky130_fd_sc_hd__or4b_2 -dont_use sky130_fd_sc_hd__or4b_4 -dont_use sky130_fd_sc_hd__or4bb_1 -dont_use sky130_fd_sc_hd__or4bb_2 -dont_use sky130_fd_sc_hd__or4bb_4 -dont_use sky130_fd_sc_hd__clkbuf_1 -dont_use sky130_fd_sc_hd__clkbuf_2 -dont_use sky130_fd_sc_hd__clkbuf_4 -dont_use sky130_fd_sc_hd__clkbuf_8 -dont_use sky130_fd_sc_hd__clkbuf_16 -dont_use sky130_fd_sc_hd__clkdlybuf4s15_1 -dont_use sky130_fd_sc_hd__clkdlybuf4s15_2 -dont_use sky130_fd_sc_hd__clkdlybuf4s18_1 -dont_use sky130_fd_sc_hd__clkdlybuf4s18_2 -dont_use sky130_fd_sc_hd__clkdlybuf4s25_1 -dont_use sky130_fd_sc_hd__clkdlybuf4s25_2 -dont_use sky130_fd_sc_hd__clkdlybuf4s50_1 -dont_use sky130_fd_sc_hd__clkdlybuf4s50_2 -dont_use sky130_fd_sc_hd__conb_1 -dont_use sky130_fd_sc_hd__decap_12 -dont_use sky130_fd_sc_hd__decap_3 -dont_use sky130_fd_sc_hd__decap_4 -dont_use sky130_fd_sc_hd__decap_6 -dont_use sky130_fd_sc_hd__decap_8 -dont_use sky130_fd_sc_hd__diode_2 -dont_use sky130_fd_sc_hd__dlygate4sd1_1 -dont_use sky130_fd_sc_hd__dlygate4sd2_1 -dont_use sky130_fd_sc_hd__dlygate4sd3_1 -dont_use sky130_fd_sc_hd__dlymetal6s2s_1 -dont_use sky130_fd_sc_hd__dlymetal6s4s_1 -dont_use sky130_fd_sc_hd__dlymetal6s6s_1 -dont_use sky130_fd_sc_hd__ebufn_1 -dont_use sky130_fd_sc_hd__ebufn_2 -dont_use sky130_fd_sc_hd__ebufn_4 -dont_use sky130_fd_sc_hd__ebufn_8 -dont_use sky130_fd_sc_hd__lpflow_bleeder_1 -dont_use sky130_fd_sc_hd__lpflow_clkbufkapwr_1 -dont_use sky130_fd_sc_hd__lpflow_clkbufkapwr_16 -dont_use sky130_fd_sc_hd__lpflow_clkbufkapwr_2 -dont_use sky130_fd_sc_hd__lpflow_clkbufkapwr_4 -dont_use sky130_fd_sc_hd__lpflow_clkbufkapwr_8 -dont_use sky130_fd_sc_hd__lpflow_clkinvkapwr_1 -dont_use sky130_fd_sc_hd__lpflow_clkinvkapwr_16 -dont_use sky130_fd_sc_hd__lpflow_clkinvkapwr_2 -dont_use sky130_fd_sc_hd__lpflow_clkinvkapwr_4 -dont_use sky130_fd_sc_hd__lpflow_clkinvkapwr_8 -dont_use sky130_fd_sc_hd__lpflow_decapkapwr_12 -dont_use sky130_fd_sc_hd__lpflow_decapkapwr_3 -dont_use sky130_fd_sc_hd__lpflow_decapkapwr_4 -dont_use sky130_fd_sc_hd__lpflow_decapkapwr_6 -dont_use sky130_fd_sc_hd__lpflow_decapkapwr_8 -dont_use sky130_fd_sc_hd__lpflow_inputiso0n_1 -dont_use sky130_fd_sc_hd__lpflow_inputiso0p_1 -dont_use sky130_fd_sc_hd__lpflow_inputiso1n_1 -dont_use sky130_fd_sc_hd__lpflow_inputiso1p_1 -dont_use sky130_fd_sc_hd__lpflow_inputisolatch_1 -dont_use sky130_fd_sc_hd__lpflow_isobufsrc_1 -dont_use sky130_fd_sc_hd__lpflow_isobufsrc_16 -dont_use sky130_fd_sc_hd__lpflow_isobufsrc_2 -dont_use sky130_fd_sc_hd__lpflow_isobufsrc_4 -dont_use sky130_fd_sc_hd__lpflow_isobufsrc_8 -dont_use sky130_fd_sc_hd__lpflow_isobufsrckapwr_16 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_hl_isowell_tap_1 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_hl_isowell_tap_2 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_hl_isowell_tap_4 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_isowell_4 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_isowell_tap_1 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_isowell_tap_2 -dont_use sky130_fd_sc_hd__lpflow_lsbuf_lh_isowell_tap_4 -dont_use sky130_fd_sc_hd__macro_sparecell -dont_use sky130_fd_sc_hd__probe_p_8 -dont_use sky130_fd_sc_hd__probec_p_8 -dont_use sky130_fd_sc_hd__sdfbbn_1 -dont_use sky130_fd_sc_hd__sdfbbn_2 -dont_use sky130_fd_sc_hd__sdfbbp_1 -dont_use sky130_fd_sc_hd__sdfrbp_1 -dont_use sky130_fd_sc_hd__sdfrbp_2 -dont_use sky130_fd_sc_hd__sdfrtn_1 -dont_use sky130_fd_sc_hd__sdfrtp_1 -dont_use sky130_fd_sc_hd__sdfrtp_2 -dont_use sky130_fd_sc_hd__sdfrtp_4 -dont_use sky130_fd_sc_hd__sdfsbp_1 -dont_use sky130_fd_sc_hd__sdfsbp_2 -dont_use sky130_fd_sc_hd__sdfstp_1 -dont_use sky130_fd_sc_hd__sdfstp_2 -dont_use sky130_fd_sc_hd__sdfstp_4 -dont_use sky130_fd_sc_hd__sdfxbp_1 -dont_use sky130_fd_sc_hd__sdfxbp_2 -dont_use sky130_fd_sc_hd__sdfxtp_1 -dont_use sky130_fd_sc_hd__sdfxtp_2 -dont_use sky130_fd_sc_hd__sdfxtp_4
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
opt_clean
stat -liberty asic/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr asic/build/nand_sol_subsystem_top.nl.v
